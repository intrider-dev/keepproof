COMPOSE_PROJECT_NAME=keepproof
APP_PORT=8080
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,localhost:5173,127.0.0.1,127.0.0.1:8080,127.0.0.1:5173,nginx,nginx:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173,http://nginx:8080
POSTGRES_DB=keepproof
POSTGRES_USER=keepproof
POSTGRES_PASSWORD=keepproof_local_only
REDIS_PASSWORD=keepproof_local_only
S3_ACCESS_KEY=keepproof-local
S3_SECRET_KEY=keepproof-local-secret
S3_BUCKET=keepproof-private
OCR_DRIVER=tesseract
RECEIPT_DATA_EXTRACTOR=patterns
RECEIPT_RECONCILE_AFTER_SECONDS=300
RECEIPT_RECONCILE_BATCH_SIZE=100
EXTERNAL_AI_ENABLED=false
EXTERNAL_AI_ENDPOINT=
EXTERNAL_AI_API_KEY=
EXTERNAL_AI_PROVIDER=generic-json
EXTERNAL_AI_MODEL=configured-model
EXTERNAL_AI_CONNECT_TIMEOUT_SECONDS=3
EXTERNAL_AI_TIMEOUT_SECONDS=10
EXTERNAL_AI_HTTP_ATTEMPTS=2
EXTERNAL_AI_RETRY_DELAY_MS=200
EXTERNAL_AI_MAX_INPUT_CHARS=16000
EXTERNAL_AI_MAX_INPUT_TOKENS=8000
EXTERNAL_AI_MAX_OUTPUT_TOKENS=1200
EXTERNAL_AI_MAX_ESTIMATED_COST_MICROS=25000
EXTERNAL_AI_MAX_RESPONSE_BYTES=65536

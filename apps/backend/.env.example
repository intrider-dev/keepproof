APP_NAME=KeepProof
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,localhost:5173,127.0.0.1,127.0.0.1:8080,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
RECEIPT_DISK=local
OCR_DRIVER=fixture
RECEIPT_DATA_EXTRACTOR=patterns
RECEIPT_SIGNED_URL_MINUTES=5
RECEIPT_RECONCILE_AFTER_SECONDS=300
RECEIPT_RECONCILE_BATCH_SIZE=100
EXTERNAL_AI_ENABLED=false
EXTERNAL_AI_ENDPOINT=
EXTERNAL_AI_API_KEY=
EXTERNAL_AI_PROVIDER=generic-json
EXTERNAL_AI_MODEL=configured-model
EXTERNAL_AI_CONNECT_TIMEOUT_SECONDS=3
EXTERNAL_AI_TIMEOUT_SECONDS=10
EXTERNAL_AI_HTTP_ATTEMPTS=2
EXTERNAL_AI_RETRY_DELAY_MS=200
EXTERNAL_AI_MAX_INPUT_CHARS=16000
EXTERNAL_AI_MAX_INPUT_TOKENS=8000
EXTERNAL_AI_MAX_OUTPUT_TOKENS=1200
EXTERNAL_AI_MAX_ESTIMATED_COST_MICROS=25000
EXTERNAL_AI_MAX_RESPONSE_BYTES=65536
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notifications@keepproof.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

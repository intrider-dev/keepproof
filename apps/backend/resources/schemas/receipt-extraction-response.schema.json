{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keepproof.local/schemas/receipt-extraction-response-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["fields", "usage"],
  "properties": {
    "fields": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value", "normalized_value", "confidence", "validation_errors"],
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "merchant",
              "purchase_date",
              "receipt_number",
              "currency",
              "total_minor",
              "country_region",
              "item_name",
              "return_period_quantity",
              "return_period_unit",
              "warranty_period_quantity",
              "warranty_period_unit"
            ]
          },
          "value": { "type": ["string", "null"], "maxLength": 500 },
          "normalized_value": { "type": ["string", "null"], "maxLength": 500 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "validation_errors": {
            "type": "array",
            "maxItems": 10,
            "items": { "type": "string", "maxLength": 200 }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "estimated_cost_micros"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "estimated_cost_micros": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

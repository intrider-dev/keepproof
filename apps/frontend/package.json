{
  "name": "@keepproof/frontend",
  "private": true,
  "version": "0.1.0-rc.1",
  "type": "module",
  "scarfSettings": {
    "enabled": false
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "security": "npm audit --audit-level=high",
    "quality": "npm run format:check && npm run lint:api && npm run check:api && npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run security",
    "generate:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check",
    "lint:api": "redocly lint --config ../../redocly.yaml ../backend/openapi/openapi.yaml"
  },
  "dependencies": {
    "swagger-ui-dist": "5.32.9",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.62.1",
    "@redocly/cli": "2.43.1",
    "@testing-library/vue": "8.1.0",
    "@types/node": "26.1.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.8.0",
    "happy-dom": "20.11.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  }
}
